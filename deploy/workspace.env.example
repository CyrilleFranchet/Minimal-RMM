# Native workspace service: one file, workspace ID, and data directory per operator.
# Shell-compatible: load with set -a; . /path/to/workspace.env; set +a.
RMM_C2_URL='http://10.254.50.203:8080'
RMM_WORKSPACE_ID=alice
# Must match alice in the central RMM_WORKSPACES registry.
RMM_WORKSPACE_TOKEN='replace-with-alice-workspace-secret'
# Separate browser/CLI/MCP credential; not the central administrator token.
RMM_WORKSPACE_LOCAL_TOKEN='replace-with-a-local-workspace-secret'
# Choose a directory on a persistent Exegol volume/mount.
RMM_WORKSPACE_DATA=/workspace/minimal-rmm-data/alice
RMM_WORKSPACE_BIND=127.0.0.1
RMM_WORKSPACE_PORT=8787
RMM_WORKSPACE_AUTO_CLAIM=0
RMM_WORKSPACE_MAX_BODY=134217728
RMM_ASSET_MAX_BYTES=134217728
# Optional private plugin access; Contents: read for the selected repository.
RMM_PLUGIN_GITHUB_TOKEN=''
