# Legacy environment migration template. For new setups use rmm_settings.py
# and docs/service-settings.md; nonempty environment values override saved settings.
# Native central server: copy outside the repository, protect, and edit.
# Shell-compatible: load with set -a; . /path/to/central.env; set +a.
RMM_STORAGE_MODE=workspace
RMM_API_TOKEN='replace-with-a-central-admin-secret'
RMM_BEACON_SECRET='replace-with-an-agent-beacon-secret'
RMM_WORKSPACES='{"alice":"replace-with-alice-workspace-secret"}'
RMM_ADMIN_PORT=8080
RMM_BEACON_PORT=8081
# Initial private-network deployment; enable a transport profile separately.
RMM_PROFILE_AUTOSTART=0
RMM_BEACON_PUBLIC_URL='http://10.254.50.203:8081'
# Includes base64 synchronization of the largest current plugin.
RMM_MAX_BODY_BYTES=134217728
