# Central control-plane secrets.
RMM_API_TOKEN=change-this-operator-token
RMM_BEACON_SECRET=change-this-beacon-secret

# Workspace registry: JSON object mapping workspace IDs to unique tokens.
RMM_WORKSPACES={"alice":"change-this-alice-workspace-token","bob":"change-this-bob-workspace-token"}
RMM_STORAGE_MODE=workspace
RMM_ADMIN_PORT=8080
RMM_BEACON_PORT=8081
RMM_PROFILE_NAME=cloudflared
RMM_PROFILE_AUTOSTART=1

# Install RMM-Profile bundles in this volume. The Cloudflared profile runner
# expects a cloudflared executable in the control-plane container PATH unless
# its bundle manifest supplies another command.
RMM_PROFILE_STORE=rmm-profile-store

# Persistent Go/PowerShell plugin artifact store. Leave unset for the named
# Docker volume, or set it to a host directory such as ./plugin-store for
# direct artifact deployment without rebuilding the RMM image.
# RMM_PLUGIN_STORE=./plugin-store

# Optional local workspace sidecar settings.
RMM_WORKSPACE_ID=alice
RMM_WORKSPACE_TOKEN=change-this-alice-workspace-token
RMM_WORKSPACE_LOCAL_TOKEN=change-this-local-workspace-token
RMM_WORKSPACE_PORT=8787
RMM_WORKSPACE_DATA=/workspace/data

# Workspace-local rclone settings. Create tools/rclone/profiles.json on the
# operator host; these values are passed only to the workspace service.
RMM_RCLONE_PROFILES_FILE=/workspace/rclone/profiles.json
RMM_RCLONE_DEFAULT_PROFILE=mega-lab
RMM_RCLONE_MAX_BYTES=0

# Private GitHub plugin releases. Only populate the token for the storage owner.
# Fine-grained token: selected plugin repository, Contents: read.
RMM_PLUGIN_REPOSITORY=CyrilleFranchet/Minimal-RMM-plugins
# This repository seeds the default source once. Edit saved repos/branches in UI.
# Additional credentials: pass RMM_PLUGIN_TOKEN_<NAME> into the service environment
# and select that variable name in the source editor (never paste its secret).
RMM_WORKSPACE_PLUGIN_GITHUB_TOKEN=
# For RMM_STORAGE_MODE=server, use this instead of the workspace token.
RMM_SERVER_PLUGIN_GITHUB_TOKEN=

# Allow all current plugins, including the 75 MB DLL and base64 workspace sync.
RMM_ASSET_MAX_BYTES=134217728
RMM_MAX_BODY_BYTES=134217728
RMM_WORKSPACE_MAX_BODY=134217728
