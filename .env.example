# Docker Compose interpolation only; do not source this file in a shell.
# Store operational settings/secrets using rmm_settings.py and the persistent
# service volume. See docs/service-settings.md and docs/deployment.md.
RMM_STORAGE_MODE=workspace
RMM_ADMIN_PORT=8080
RMM_BEACON_PORT=8081
RMM_WORKSPACE_PORT=8787

# Optional host mounts; leave unset for persistent named Docker volumes.
# RMM_PROFILE_STORE=./profile-store
# RMM_PLUGIN_STORE=./plugin-store

# Optional legacy overrides. Nonempty values override saved configuration.
# Prefer offline initialization with --value-file or a protected JSON import.
# RMM_API_TOKEN=
# RMM_BEACON_SECRET=
# RMM_WORKSPACES={"alice":"replace-with-workspace-token"}
# RMM_C2_URL=http://rmm-control:8080
# RMM_WORKSPACE_ID=alice
# RMM_WORKSPACE_TOKEN=
# RMM_WORKSPACE_LOCAL_TOKEN=
# RMM_SERVER_PLUGIN_GITHUB_TOKEN=
# RMM_WORKSPACE_PLUGIN_GITHUB_TOKEN=
